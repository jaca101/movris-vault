msgid "{n} month ago"
msgid_plural "{n} months ago"
msgstr[0] "hace {n} mes"
msgstr[1] "hace {n} meses"

#: src/movris_vault/fmt.py:38
msgid "{minutes} min"
msgstr "{minutes} min"

#: src/movris_vault/fmt.py:48
msgid "today at {time}"
msgstr "hoy a las {time}"

