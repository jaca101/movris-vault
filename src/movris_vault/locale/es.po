msgid "Password changed."
msgstr "Contraseña cambiada."

#: src/movris_vault/cli.py:76
msgid "Encrypted backup turned on and password saved in the keyring."
msgstr "Copia cifrada activada y contraseña guardada en el llavero."

#: src/movris_vault/cli.py:85
msgid "complete"
msgstr "completa"

#: src/movris_vault/cli.py:85
msgid "INCOMPLETE"
msgstr "INCOMPLETA"

