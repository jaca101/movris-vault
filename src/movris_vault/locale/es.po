msgid "encrypted"
msgstr "cifrada"

#: src/movris_vault/cli.py:86 src/movris_vault/ui/window.py:426
msgid "not encrypted"
msgstr "sin cifrar"

#: src/movris_vault/cli.py:110
msgid "Encryption has changed: the previous backup is set aside and put back if this one doesn't finish."
msgstr "El cifrado ha cambiado: la copia anterior se aparta y vuelve a su sitio si esta no termina."

#: src/movris_vault/cli.py:116
msgid "The iPhone is preparing the data (this can take a couple of minutes)…"
msgstr "El iPhone está preparando los datos (puede tardar un par de minutos)…"

#: src/movris_vault/cli.py:134 src/movris_vault/ui/window.py:531
msgid "iPhone backup in progress"
msgstr "Copia del iPhone en curso"

#: src/movris_vault/cli.py:147 src/movris_vault/ui/app.py:63
msgid "Encrypted iPhone backups for Linux."
msgstr "Copias de seguridad cifradas del iPhone en Linux."

#: src/movris_vault/cli.py:149
msgid "details of the connected iPhone"
msgstr "datos del iPhone conectado"

#: src/movris_vault/cli.py:150
msgid "pair (tap “Trust” on the iPhone)"
msgstr "emparejar (pulsar «Confiar» en el iPhone)"

#: src/movris_vault/cli.py:151
msgid "saved backups"
msgstr "copias guardadas"

#: src/movris_vault/cli.py:151
msgid "make a backup"
msgstr "hacer una copia"

#: src/movris_vault/cli.py:152
msgid "turn on encrypted backups or change their password"
msgstr "activar la copia cifrada o cambiar su contraseña"

#: src/movris_vault/cli.py:22
msgid "Connecting to the iPhone…"
msgstr "Conectando con el iPhone…"

#: src/movris_vault/cli.py:23
msgid "Enter your passcode on the iPhone so the backup can start."
msgstr "Escribe tu código en el iPhone para que empiece la copia."

#: src/movris_vault/cli.py:24
msgid "Copying…"
msgstr "Copiando…"

#: src/movris_vault/cli.py:26
msgid "Backup cancelled."
msgstr "Copia cancelada."

#: src/movris_vault/cli.py:40
msgid "Used: {used} of {capacity}"
msgstr "Usado: {used} de {capacity}"

#: src/movris_vault/cli.py:66
msgid "Current backup password: "
msgstr "Contraseña actual de las copias: "

#: src/movris_vault/cli.py:106
msgid "The laptop is on battery: plug it in so it doesn't run out halfway."
msgstr "El portátil va con batería: enchúfalo para que no se apague a mitad."

#: src/movris_vault/cli.py:125
msgid "(seems stuck: if it doesn't move, unplug the cable and plug it back in)"
msgstr "(parece atascado: si no avanza, desconecta y vuelve a conectar el cable)"

#: src/movris_vault/cli.py:154
msgid "backup folder"
msgstr "carpeta de copias"

#: src/movris_vault/cli.py:25
msgid "Backup finished."
msgstr "Copia terminada."

#: src/movris_vault/cli.py:33
msgid "No iPhone connected."
msgstr "No hay ningún iPhone conectado."

#: src/movris_vault/cli.py:34
msgid "The iPhone is plugged in but not responding: unplug the cable and plug it back in."
msgstr "El iPhone está enchufado pero no responde: desconecta y vuelve a conectar el cable."

#: src/movris_vault/cli.py:35
msgid "The iPhone doesn't trust this computer yet (use `pair`)."
msgstr "El iPhone no confía todavía en este ordenador (usa `pair`)."

#: src/movris_vault/cli.py:83
msgid "No backups in {folder}"
msgstr "No hay copias en {folder}"

#: src/movris_vault/cli.py:102
msgid "Not enough space: about {needed} must be free and there is {free}."
msgstr "Falta espacio: hacen falta unos {needed} libres y hay {free}."

#: src/movris_vault/cli.py:141
msgid "The previous backup is still in {path}; delete it whenever you like."
msgstr "La copia anterior sigue en {path}; bórrala cuando quieras."

#: src/movris_vault/cli.py:156
msgid "full backup even if one already exists"
msgstr "copia completa aunque ya exista una"

#: src/movris_vault/cli.py:119
msgid "{percent} · {received} · {speed}/s · {eta} left"
msgstr "{percent} · {received} · {speed}/s · quedan {eta}"

#: src/movris_vault/core/backup.py:213
msgid "The backup didn't finish properly"
msgstr "La copia no ha terminado bien"

#: src/movris_vault/core/backup.py:214
msgid "The iPhone stopped sending data before the end. Try again."
msgstr "El iPhone dejó de enviar datos antes de acabar. Vuelve a intentarlo."

#: src/movris_vault/core/backup.py:223
msgid "If the next backup doesn't start, unplug the cable and plug it back in."
msgstr "Si la próxima copia no arranca, desconecta y vuelve a conectar el cable."

#: src/movris_vault/core/encryption.py:31
msgid "The two passwords don't match."
msgstr "Las dos contraseñas no coinciden."

#: src/movris_vault/core/encryption.py:29
msgid "It must have at least {n} characters."
msgstr "Tiene que tener al menos {n} caracteres."

#: src/movris_vault/core/encryption.py:51
msgid "Backup password for {device} (Movris Vault)"
msgstr "Contraseña de las copias de {device} (Movris Vault)"

#: src/movris_vault/core/encryption.py:87
msgid "The iPhone didn't turn on encryption"
msgstr "El iPhone no ha activado el cifrado"

#: src/movris_vault/core/encryption.py:88
msgid "Unlock it, enter your passcode if it asks for it, and try again."
msgstr "Desbloquéalo, escribe tu código si te lo pide y vuelve a intentarlo."

#: src/movris_vault/core/encryption.py:83
msgid "The iPhone didn't accept the change"
msgstr "El iPhone no ha aceptado el cambio"

#: src/movris_vault/core/encryption.py:84
msgid "The current password may not be the right one."
msgstr "Puede que la contraseña anterior no sea la correcta."

#: src/movris_vault/core/errors.py:35
msgid "Lost the connection to the iPhone"
msgstr "Se ha perdido la conexión con el iPhone"

#: src/movris_vault/core/errors.py:36
msgid "Check that the cable is still plugged in and try again."
msgstr "Comprueba que el cable sigue bien conectado y vuelve a intentarlo."

#: src/movris_vault/core/errors.py:42
msgid "The backup was cancelled on the iPhone"
msgstr "La copia se ha cancelado desde el iPhone"

#: src/movris_vault/core/errors.py:43
msgid "If you didn't mean to, start again and don't touch the iPhone until it finishes."
msgstr "Si no querías cancelarla, vuelve a empezar y no toques el iPhone hasta que termine."

#: src/movris_vault/core/errors.py:74
msgid "The backup couldn't be completed"
msgstr "La copia no se ha podido completar"

#: src/movris_vault/core/errors.py:51
msgid "No iPhone found"
msgstr "No encuentro ningún iPhone"

#: src/movris_vault/core/errors.py:51
msgid "Plug it in with the USB cable and unlock it."
msgstr "Conéctalo con el cable USB y desbloquéalo."

#: src/movris_vault/core/errors.py:55
msgid "The iPhone is locked"
msgstr "El iPhone está bloqueado"

#: src/movris_vault/core/errors.py:55
msgid "Unlock it with your passcode and try again."
msgstr "Desbloquéalo con tu código y vuelve a intentarlo."

#: src/movris_vault/core/errors.py:58
msgid "“Don't Trust” was tapped on the iPhone"
msgstr "En el iPhone se pulsó «No confiar»"

#: src/movris_vault/core/errors.py:59
msgid "Unplug the cable, plug it back in and tap “Trust” this time."
msgstr "Desconecta y vuelve a conectar el cable, y esta vez pulsa «Confiar»."

#: src/movris_vault/core/errors.py:62
msgid "The iPhone doesn't trust this computer yet"
msgstr "El iPhone todavía no confía en este ordenador"

#: src/movris_vault/core/errors.py:62
msgid "Tap “Trust” on the iPhone."
msgstr "Pulsa «Confiar» en el iPhone."

#: src/movris_vault/core/errors.py:65
msgid "The disk is full"
msgstr "No queda espacio en el disco"

#: src/movris_vault/core/errors.py:66
msgid "Free up some space or choose another folder, for example on an external disk."
msgstr "Libera espacio o elige otra carpeta, por ejemplo en un disco externo."

#: src/movris_vault/core/errors.py:70
msgid "Can't write to the backup folder"
msgstr "No puedo escribir en la carpeta de copias"

#: src/movris_vault/core/errors.py:75
msgid "Technical detail: {detail}"
msgstr "Detalle técnico: {detail}"

#: src/movris_vault/core/errors.py:71
msgid "Check the permissions of {path}."
msgstr "Revisa los permisos de {path}."

#: src/movris_vault/fmt.py:33
msgid "calculating…"
msgstr "calculando…"

#: src/movris_vault/fmt.py:36
msgid "less than a minute"
msgstr "menos de un minuto"

#: src/movris_vault/fmt.py:44
msgid "never"
msgstr "nunca"

#: src/movris_vault/fmt.py:50
msgid "yesterday"
msgstr "ayer"

