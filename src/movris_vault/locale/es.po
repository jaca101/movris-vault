msgid "If the iPhone asks for your passcode, enter it."
msgstr "Si el iPhone te pide el código, escríbelo."

#: src/movris_vault/cli.py:107
msgid "Incremental backup of {device} in {folder}"
msgstr "Copia incremental de {device} en {folder}"

#: src/movris_vault/cli.py:107
msgid "Full backup of {device} in {folder}"
msgstr "Copia completa de {device} en {folder}"

