msgid "Back up now"
msgstr "Hacer copia ahora"

#: src/movris_vault/ui/window.py:181 src/movris_vault/ui/window.py:225 src/movris_vault/ui/window.py:350 src/movris_vault/ui/window.py:534
msgid "Cancel"
msgstr "Cancelar"

#: src/movris_vault/ui/window.py:191
msgid "Back"
msgstr "Volver"

#: src/movris_vault/ui/window.py:239
msgid "OK"
msgstr "Entendido"

#: src/movris_vault/ui/window.py:325
msgid "Turn on encrypted backup"
msgstr "Activar la copia cifrada"

#: src/movris_vault/ui/window.py:326
msgid "This way the backup also keeps passwords, Health data and WhatsApp.\n\nWe recommend using the same password you use to log in to this computer, so there's only one to remember. It will be saved in the computer's keyring.\n\nThe next backup will be a full one and can take several hours. The current backup is kept until the new one finishes."
msgstr "Así la copia guarda también las contraseñas, los datos de Salud y los de WhatsApp.\n\nTe recomendamos usar la misma contraseña con la que entras en el ordenador: así solo tienes que recordar una. Se guardará en el llavero del ordenador.\n\nLa próxima copia será completa y puede tardar varias horas. La copia actual se conserva hasta que la nueva termine."

#: src/movris_vault/ui/window.py:332
msgid "Change the backup password"
msgstr "Cambiar la contraseña de las copias"

#: src/movris_vault/ui/window.py:333
msgid "If you have changed the password you use to log in to this computer, enter the new one here so they stay the same."
msgstr "Si has cambiado la contraseña con la que entras en el ordenador, escribe aquí la nueva para que sigan siendo la misma."

#: src/movris_vault/ui/window.py:485
msgid "Delete the previous backup?"
msgstr "¿Borrar la copia anterior?"

#: src/movris_vault/ui/window.py:487
msgid "Delete"
msgstr "Borrar"

#: src/movris_vault/ui/window.py:548
msgid "The iPhone is preparing the data. This can take a couple of minutes."
msgstr "El iPhone está preparando los datos. Puede tardar un par de minutos."

#: src/movris_vault/ui/window.py:592
msgid "Cancel the backup?"
msgstr "¿Cancelar la copia?"

#: src/movris_vault/ui/window.py:592
msgid "The backup won't be complete and will have to be done again."
msgstr "La copia no quedará completa y habrá que hacerla otra vez."

#: src/movris_vault/ui/window.py:593
msgid "Cancel backup"
msgstr "Cancelar copia"

#: src/movris_vault/ui/window.py:37
msgid "Connect the iPhone"
msgstr "Conecta el iPhone"

#: src/movris_vault/ui/window.py:37
msgid "Use the USB cable and unlock it."
msgstr "Usa el cable USB y desbloquéalo."

#: src/movris_vault/ui/window.py:40
msgid "Unplug the cable and plug it back in"
msgstr "Desconecta y vuelve a conectar el cable"

#: src/movris_vault/ui/window.py:41
msgid "The iPhone is plugged in but not responding. This sometimes happens after the laptop has slept."
msgstr "El iPhone está enchufado pero no responde. Pasa a veces cuando el portátil se ha dormido."

#: src/movris_vault/ui/window.py:45
msgid "Look at the iPhone"
msgstr "Mira el iPhone"

#: src/movris_vault/ui/window.py:46
msgid "Tap “Trust” and enter your passcode.\nYou only need to do this the first time."
msgstr "Pulsa «Confiar» y escribe tu código.\nSolo hace falta la primera vez."

#: src/movris_vault/ui/window.py:53
msgid "Preparing the backup…"
msgstr "Preparando la copia…"

#: src/movris_vault/ui/window.py:53
msgid "Connecting to the iPhone."
msgstr "Conectando con el iPhone."

#: src/movris_vault/ui/window.py:56
msgid "Enter your passcode on the iPhone"
msgstr "Escribe tu código en el iPhone"

#: src/movris_vault/ui/window.py:57
msgid "The iPhone asks for it to start the backup."
msgstr "El iPhone lo pide para empezar la copia."

#: src/movris_vault/ui/window.py:59
msgid "Backing up the iPhone…"
msgstr "Copiando el iPhone…"

#: src/movris_vault/ui/window.py:100
msgid "The laptop is on battery: plug it in before backing up."
msgstr "El portátil va con batería: enchúfalo antes de hacer la copia."

#: src/movris_vault/ui/window.py:145
msgid "Encryption"
msgstr "Cifrado"

#: src/movris_vault/ui/window.py:146
msgid "Encrypted backup"
msgstr "Copia cifrada"

#: src/movris_vault/ui/window.py:153
msgid "Saved backups"
msgstr "Copias guardadas"

#: src/movris_vault/ui/window.py:157
msgid "Where they are saved"
msgstr "Dónde se guardan"

#: src/movris_vault/ui/window.py:158
msgid "Folder"
msgstr "Carpeta"

#: src/movris_vault/ui/window.py:159
msgid "Change…"
msgstr "Cambiar…"

#: src/movris_vault/ui/window.py:176
msgid "It doesn't seem to be moving. If it stays like this for a few minutes, cancel, unplug the cable and plug it back in."
msgstr "Parece que no avanza. Si sigue así unos minutos, cancela, desconecta el cable y vuelve a conectarlo."

#: src/movris_vault/ui/window.py:195
msgid "Delete the previous unencrypted backup"
msgstr "Borrar la copia anterior sin cifrar"

#: src/movris_vault/ui/window.py:302
msgid "On: the backup also keeps passwords, Health and WhatsApp."
msgstr "Activada: la copia guarda también contraseñas, Salud y WhatsApp."

#: src/movris_vault/ui/window.py:303
msgid "Change password…"
msgstr "Cambiar contraseña…"

#: src/movris_vault/ui/window.py:306
msgid "Off: the backup doesn't keep passwords, Health or WhatsApp data."
msgstr "Desactivada: la copia no guarda contraseñas, ni datos de Salud ni de WhatsApp."

#: src/movris_vault/ui/window.py:307
msgid "Turn on…"
msgstr "Activar…"

#: src/movris_vault/ui/window.py:337
msgid "Current backup password"
msgstr "Contraseña actual de las copias"

#: src/movris_vault/ui/window.py:340
msgid "New password"
msgstr "Contraseña nueva"

#: src/movris_vault/ui/window.py:341
msgid "Repeat it"
msgstr "Repítela"

#: src/movris_vault/ui/window.py:351
msgid "Turn on"
msgstr "Activar"

#: src/movris_vault/ui/window.py:351
msgid "Change"
msgstr "Cambiar"

#: src/movris_vault/ui/window.py:378
msgid "Changing the password…"
msgstr "Cambiando la contraseña…"

#: src/movris_vault/ui/window.py:378
msgid "Turning on encryption…"
msgstr "Activando el cifrado…"

#: src/movris_vault/ui/window.py:434
msgid "Open folder"
msgstr "Abrir carpeta"

#: src/movris_vault/ui/window.py:454
msgid "There's no backup of this iPhone yet"
msgstr "Todavía no hay ninguna copia de este iPhone"

#: src/movris_vault/ui/window.py:462
msgid "Since encryption has changed, the next backup will be a full one and can take several hours. The current backup is kept until the new one finishes."
msgstr "Como ha cambiado el cifrado, la próxima copia será completa y puede tardar varias horas. La copia actual se conserva hasta que la nueva termine."

#: src/movris_vault/ui/window.py:490
msgid "Choose where to save backups"
msgstr "Elige dónde guardar las copias"

#: src/movris_vault/ui/window.py:514
msgid "Not enough space"
msgstr "No hay espacio suficiente"

#: src/movris_vault/ui/window.py:520
msgid "The laptop is on battery"
msgstr "El portátil va con batería"

#: src/movris_vault/ui/window.py:521
msgid "The backup can take a long time. If the battery runs out halfway, it will have to be redone."
msgstr "La copia puede tardar mucho. Si se queda sin batería a mitad, habrá que repetirla."

#: src/movris_vault/ui/window.py:522
msgid "Start anyway"
msgstr "Empezar igualmente"

#: src/movris_vault/ui/window.py:593
msgid "Keep backing up"
msgstr "Seguir copiando"

#: src/movris_vault/ui/window.py:606
msgid "Backup finished!"
msgstr "¡Copia terminada!"

#: src/movris_vault/ui/window.py:98
msgid "Main menu"
msgstr "Menú principal"

#: src/movris_vault/ui/window.py:180
msgid "Don't unplug the iPhone."
msgstr "No desconectes el iPhone."

#: src/movris_vault/ui/window.py:291
msgid "iOS {version} · {used} used of {capacity}"
msgstr "iOS {version} · {used} usados de {capacity}"

#: src/movris_vault/ui/window.py:360
msgid "The current password is missing."
msgstr "Falta la contraseña actual."

#: src/movris_vault/ui/window.py:407
msgid "{folder}\n{free} free"
msgstr "{folder}\n{free} libres"

#: src/movris_vault/ui/window.py:416
msgid "No backups yet"
msgstr "Todavía no hay ninguna copia"

#: src/movris_vault/ui/window.py:429
msgid "Didn't finish · {details}"
msgstr "No terminó · {details}"

#: src/movris_vault/ui/window.py:430
msgid "{device} (previous backup)"
msgstr "{device} (copia anterior)"

#: src/movris_vault/ui/window.py:439
msgid "Delete this backup"
msgstr "Borrar esta copia"

#: src/movris_vault/ui/window.py:456
msgid "The last backup didn't finish"
msgstr "La última copia no terminó"

#: src/movris_vault/ui/window.py:466
msgid "Only what changed since last time will be copied."
msgstr "Solo se copiará lo que ha cambiado desde la última vez."

#: src/movris_vault/ui/window.py:468
msgid "The first backup can take several hours."
msgstr "La primera copia puede tardar varias horas."

#: src/movris_vault/ui/window.py:479
msgid "Couldn't delete it"
msgstr "No se ha podido borrar"

#: src/movris_vault/ui/window.py:486
msgid "{name} will be deleted for good. The new backup is not touched."
msgstr "Se borrará {name} para siempre. La copia nueva no se toca."

#: src/movris_vault/ui/window.py:522
msgid "Wait"
msgstr "Esperar"

#: src/movris_vault/ui/window.py:560
msgid "Comparing with the previous backup…"
msgstr "Comparando con la copia anterior…"

#: src/movris_vault/ui/window.py:588
msgid "Cancelling…"
msgstr "Cancelando…"

#: src/movris_vault/ui/window.py:607
msgid "Saved in {folder}.\nYou can unplug the iPhone now."
msgstr "Guardada en {folder}.\nYa puedes desconectar el iPhone."

#: src/movris_vault/ui/window.py:609
msgid "The previous unencrypted backup is still saved. It's no longer needed: you can delete it."
msgstr "La copia anterior sin cifrar sigue guardada. Ya no hace falta: puedes borrarla."

#: src/movris_vault/ui/window.py:611
msgid "Backup cancelled"
msgstr "Copia cancelada"

#: src/movris_vault/ui/window.py:612
msgid "The backup was not completed."
msgstr "La copia no se ha completado."

#: src/movris_vault/ui/window.py:391
msgid "Password changed"
msgstr "Contraseña cambiada"

#: src/movris_vault/ui/window.py:391
msgid "It has been saved in the computer's keyring."
msgstr "Se ha guardado en el llavero del ordenador."

#: src/movris_vault/ui/window.py:393
msgid "Encrypted backup turned on"
msgstr "Copia cifrada activada"

#: src/movris_vault/ui/window.py:394
msgid "The password has been saved in the computer's keyring.\n\nNow press “Back up now”. It will be a full backup and can take several hours: keep the laptop plugged in."
msgstr "La contraseña se ha guardado en el llavero del ordenador.\n\nAhora pulsa «Hacer copia ahora». Será una copia completa y puede tardar varias horas: deja el portátil enchufado."

#: src/movris_vault/ui/window.py:515
msgid "About {needed} must be free and there is only {free}.\nFree up some space or choose another folder, for example on an external disk."
msgstr "Hacen falta unos {needed} libres y solo hay {free}.\nLibera espacio o elige otra carpeta, por ejemplo en un disco externo."

